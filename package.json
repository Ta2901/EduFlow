{
  "name": "eduflow",
  "version": "1.0.0",
  "description": "EduFlow - Hệ thống hỗ trợ học tập và giảng dạy",
  "private": true,
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev",
    "dev:clean": "rm -rf .next && npm run dev",
    "build": "prisma generate && npm run db:migrate:deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/apply-migrations-pg.ts",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:seed:reset": "SEED_RESET=true prisma db seed",
    "admin:reset-password": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/reset-admin-password.ts",
    "setup:db": "bash scripts/setup-postgres.sh",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "pg": "^8.16.0",
    "@types/node": "20.8.0",
    "@types/react": "18.2.25",
    "@types/react-dom": "18.2.11",
    "autoprefixer": "10.4.16",
    "bcryptjs": "^3.0.3",
    "date-fns": "2.30.0",
    "framer-motion": "10.16.4",
    "jose": "^6.2.3",
    "lucide-react": "0.292.0",
    "next": "14.0.0",
    "postcss": "8.4.31",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "7.47.0",
    "react-hot-toast": "2.4.1",
    "recharts": "2.8.0",
    "tailwindcss": "3.3.5",
    "typescript": "5.2.2",
    "zustand": "4.4.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.15.4",
    "eslint": "8.51.0",
    "eslint-config-next": "14.0.0",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2"
  }
}
