# ── PostgreSQL (cloud) — recommended ─────────────────────────────────────────
# 1. Create free database: https://neon.tech (or Supabase)
# 2. Copy connection string → paste below
# 3. Run: npm run db:migrate:deploy && npm run db:seed
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ── Local PostgreSQL (optional) ───────────────────────────────────────────────
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eduflow"

# ── Auth & app ───────────────────────────────────────────────────────────────
JWT_SECRET="your-secret-at-least-32-characters-long"
NEXT_PUBLIC_JITSI_DOMAIN="meet.jit.si"

# Show OTP on forgot-password page when email/SMS provider is not configured (dev)
AUTH_SHOW_DEV_OTP="true"

# Optional: send reset OTP via email (Resend — https://resend.com)
# RESEND_API_KEY="re_xxx"
# RESEND_FROM="EduFlow <noreply@yourdomain.com>"

# Optional: send reset OTP via SMS (Twilio)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER="+84..."

# Notes:
# - Data lives in PostgreSQL (cloud), not in git.
# - npm run db:seed is non-destructive — does not wipe existing users/passwords.
# - File uploads still save to public/uploads/ on the server (use S3 for production).
# - Forgot password: verify via recovery email (Gmail/iCloud/…) or registered phone + OTP.