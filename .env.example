DATABASE_URL="file:./dev.db"
JWT_SECRET="your-secret-at-least-32-characters-long"
NEXT_PUBLIC_JITSI_DOMAIN="meet.jit.si"

# prisma/dev.db is gitignored — user passwords persist across git pushes.
# npm run db:seed is non-destructive (does not wipe users).
# Use npm run db:seed:reset only when you want a full wipe + fresh demo data.
